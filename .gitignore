# Python
__pycache__/
*.pyc
.venv/
venv/

# Raw data (re-downloadable, can be large) — keep manifest, not the files
data/raw/**
!data/raw/**/.gitkeep

# La matriz de ruteo precomputada SI se versiona (deliverable explicito del
# enunciado: el dashboard debe funcionar sin el motor de ruteo levantado).

# Logs (keep dir, not noisy run logs)
logs/*.log

# LaTeX build artifacts
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz

# OS / editor
.DS_Store
Thumbs.db
.vscode/
